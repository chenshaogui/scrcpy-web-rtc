#!/bin/bash
# Uninstall pre-hook (native): stop the app. User data is owned by fnOS
# and may be inspected before removal, so we don't touch it.
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# cmd/ sits next to target/ etc. at the install root.
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -x "${APP_DIR}/cmd/main" ]; then
    "${APP_DIR}/cmd/main" stop || true
fi
exit 0
