# Force LF line endings on text files so Docker / shell / CI work
# consistently across Windows and Unix checkouts.
* text=auto eol=lf

# Source and config
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.xml       text eol=lf
*.iml       text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Dockerfile  text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.jar  binary
*.bin  binary