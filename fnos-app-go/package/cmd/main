#!/bin/bash
#
# scrcpy-webrtc (Go) lifecycle entry — fnOS compliant.
#
# start   -> 0 ok
# stop    -> 0 ok
# status  -> 0 running / 3 not running
# other   -> 1, with a user-visible error in $TRIM_TEMP_LOGFILE
#
# Unlike the native (Node) package there is NO nodejs_v22 dependency: the
# server and the gateway are self-contained static Go binaries shipped in
# app/. Two processes are started:
#   1. scrcpy-webrtc server  -> 127.0.0.1:18012 (HTTP + WS API, scrcpy, WebRTC)
#   2. gateway              -> unix socket app.sock, forwards /api/* to the
#                              server and serves the inlined page from web/
#
# Idempotent: install / upgrade / config flows may call start or stop
# repeatedly. We track PIDs in $VAR_DIR so repeated start is a no-op.
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

APP_DIR="${TRIM_APPDEST:-/var/apps/scrcpy-remote-go/target}"
VAR_DIR="${TRIM_PKGVAR:-$APP_DIR/var}"
LOG_FILE="${VAR_DIR}/app.log"
SERVER_PID_FILE="${VAR_DIR}/server.pid"
GATEWAY_PID_FILE="${VAR_DIR}/gateway.pid"
GATEWAY_SOCKET_FILE="${APP_DIR}/app.sock"
GATEWAY_PREFIX="/app/scrcpy-remote-go"
INNER_PORT=18012

mkdir -p "$VAR_DIR" 2>/dev/null || true

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE" 2>/dev/null
}

fail() {
    log "ERROR: $*"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$*" >"$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    fi
    exit 1
}

# fnOS install layout has shifted between versions: the fpk's app payload may
# land at $TRIM_APPDEST, $TRIM_APPDEST/app or $TRIM_APPDEST/target. Detect
# whichever actually holds the server binary.
# NOTE: fpk tar entries built on Windows carry mode 0666 (no execute bit),
# so detect with -f and chmod +x ourselves — requiring -x here made every
# Windows-built package fail to start (black iframe, no app.sock).
APP_ROOT=""
for cand in "$APP_DIR" "$APP_DIR/app" "$APP_DIR/target"; do
    if [ -f "${cand}/scrcpy-webrtc" ] && [ -f "${cand}/gateway" ]; then
        APP_ROOT="$cand"
        break
    fi
done
[ -n "$APP_ROOT" ] || fail "Go binaries (scrcpy-webrtc, gateway) not found under $APP_DIR"

# Self-heal the execute bit regardless of how the payload was unpacked.
chmod +x "${APP_ROOT}/scrcpy-webrtc" "${APP_ROOT}/gateway" 2>/dev/null || true
[ -x "${APP_ROOT}/scrcpy-webrtc" ] && [ -x "${APP_ROOT}/gateway" ] \
    || fail "cannot chmod +x Go binaries under $APP_ROOT (read-only install dir?)"

# Persist adb keys + trusted device list in the data dir so reconnects survive
# reinstall. Go reads TRIM_PKGVAR directly for devices.json and adbkey.
export HOME="${VAR_DIR}"
export TRIM_PKGVAR="$VAR_DIR"

# Optional TURN relay for remote viewers (FN Connect / different NAT): without
# it P2P fails and WebViews without WebCodecs have no video path at all. Drop a
# turn.env (KEY=VALUE lines) into the data dir, e.g.
#   TURN_URL=cloudflare  + CF_TURN_KEY_ID / CF_TURN_API_TOKEN
#   TURN_URL=turn:host:3478  + TURN_AUTH=user:pass
if [ -f "${VAR_DIR}/turn.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "${VAR_DIR}/turn.env"
    set +a
    log "loaded ${VAR_DIR}/turn.env (TURN relay enabled)"
fi

is_running() {
    [ -S "$GATEWAY_SOCKET_FILE" ] \
        && [ -f "$GATEWAY_PID_FILE" ] \
        && kill -0 "$(cat "$GATEWAY_PID_FILE" 2>/dev/null)" 2>/dev/null \
        && [ -f "$SERVER_PID_FILE" ] \
        && kill -0 "$(cat "$SERVER_PID_FILE" 2>/dev/null)" 2>/dev/null
}

start() {
    if is_running; then
        log "already running"
        exit 0
    fi

    rm -f "$GATEWAY_SOCKET_FILE" 2>/dev/null || true
    cd "$APP_ROOT" || fail "cannot cd to $APP_ROOT"

    # 1. Go server: local HTTP/WS API on 127.0.0.1:18012. No page/signal/QR:
    #    the page is served by the gateway, and fnOS is an intranet install.
    log "starting Go server (port ${INNER_PORT})"
    nohup ./scrcpy-webrtc \
        --port "$INNER_PORT" \
        --no-page --no-signal --no-qr \
        >"${VAR_DIR}/server.log" 2>&1 &
    echo $! > "$SERVER_PID_FILE"

    # 2. Go gateway: unix-socket reverse proxy + static page server.
    log "starting Go gateway (prefix=${GATEWAY_PREFIX})"
    GATEWAY_SOCKET="$GATEWAY_SOCKET_FILE" \
    GATEWAY_PREFIX="$GATEWAY_PREFIX" \
    GATEWAY_TARGET="http://127.0.0.1:${INNER_PORT}" \
    INNER_PORT="$INNER_PORT" \
    WEB_DIR="${APP_ROOT}/web" \
    LOG_FILE="${VAR_DIR}/gateway.log" \
    nohup ./gateway >"${VAR_DIR}/gateway.out" 2>&1 &
    echo $! > "$GATEWAY_PID_FILE"

    local i=0
    while [ "$i" -lt 15 ]; do
        if is_running; then
            log "started (gateway socket up)"
            exit 0
        fi
        # Server died right after launch: bail out now instead of waiting
        # 15s and leaving an orphan gateway behind.
        if ! kill -0 "$(cat "$SERVER_PID_FILE" 2>/dev/null)" 2>/dev/null; then
            log "server exited early; last server.log lines:"
            tail -n 5 "${VAR_DIR}/server.log" >>"$LOG_FILE" 2>/dev/null || true
            kill -TERM "$(cat "$GATEWAY_PID_FILE" 2>/dev/null)" 2>/dev/null || true
            rm -f "$SERVER_PID_FILE" "$GATEWAY_PID_FILE" "$GATEWAY_SOCKET_FILE" 2>/dev/null || true
            fail "Go server exited right after start (port ${INNER_PORT} in use?); see ${VAR_DIR}/server.log"
        fi
        sleep 1
        i=$((i + 1))
    done
    kill -TERM "$(cat "$GATEWAY_PID_FILE" 2>/dev/null)" 2>/dev/null || true
    kill -TERM "$(cat "$SERVER_PID_FILE" 2>/dev/null)" 2>/dev/null || true
    rm -f "$SERVER_PID_FILE" "$GATEWAY_PID_FILE" "$GATEWAY_SOCKET_FILE" 2>/dev/null || true
    fail "gateway socket not created within 15s; check ${VAR_DIR}/server.log and ${VAR_DIR}/gateway.out"
}

stop() {
    log "stopping"
    for pid_file in "$GATEWAY_PID_FILE" "$SERVER_PID_FILE"; do
        if [ -f "$pid_file" ]; then
            local pid
            pid="$(cat "$pid_file" 2>/dev/null)"
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                kill -TERM "$pid" 2>/dev/null || true
                local j=0
                while [ "$j" -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
                    sleep 1
                    j=$((j + 1))
                done
                kill -KILL "$pid" 2>/dev/null || true
            fi
            rm -f "$pid_file"
        fi
    done
    pkill -f "[/]scrcpy-webrtc --port ${INNER_PORT}" 2>/dev/null || true
    rm -f "$GATEWAY_SOCKET_FILE" 2>/dev/null || true
    exit 0
}

status() {
    if is_running; then
        exit 0
    fi
    exit 3
}

case "${1:-}" in
    start)  start ;;
    stop)   stop ;;
    status) status ;;
    *)      fail "Usage: $0 {start|stop|status}" ;;
esac
